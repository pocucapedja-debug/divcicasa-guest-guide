function copyText(text) {
  if (typeof navigator !== 'undefined' && navigator.clipboard) {
    navigator.clipboard.writeText(text)
  }
}

function ActionButton({ href, children, light }) {
  return <a className={light ? 'btn light' : 'btn'} href={href} target={href?.startsWith('http') ? '_blank' : undefined}>{children}</a>
}

