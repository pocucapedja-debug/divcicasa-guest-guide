          </div>
          <div className="wifiBox">
            <div><small>Mreža</small><strong>{apartment.wifiName}</strong></div>
            <button onClick={() => copyText(apartment.wifiName)}><Copy size={16}/> Kopiraj</button>
            <div><small>Lozinka</small><strong>{apartment.wifiPassword}</strong></div>
            <button onClick={() => copyText(apartment.wifiPassword)}><Copy size={16}/> Kopiraj</button>
